# Live AI identification. Without a key the app still runs: Demo Mode, Discover, Saved and
# every species page work, and /api/identify returns a clean "not configured" response.

# Primary provider: Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. TIDE uses gemini-flash-latest (Google's current Flash model) and falls back to
# gemini-flash-lite-latest and gemini-3-flash-preview when it's overloaded. A model set here
# is tried first.
# GEMINI_MODEL=

# Optional fallback, used only when GEMINI_API_KEY is empty.
# ANTHROPIC_API_KEY=
# TIDE_VISION_MODEL=claude-opus-5
# ANTHROPIC_WORKSPACE_ID=
