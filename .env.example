# Live AI identification. Without it the app still runs: Demo Mode, Discover, Saved and
# every species page work, and /api/identify returns a clean "not configured" response.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# TIDE_VISION_MODEL=claude-opus-5

# Only needed if your key returns "This API key is not scoped to a workspace" — pair it
# with the workspace ID from console.anthropic.com (Settings → Workspaces → your workspace).
# ANTHROPIC_WORKSPACE_ID=
